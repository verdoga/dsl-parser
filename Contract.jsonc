{
  // Абстрактный контракт результата обработки DSL-документа.
  // Это JSONC: комментарии являются частью документации контракта. После их удаления структура является валидным JSON.
  // Значения в <...>, нули и логические значения ниже обозначают места для фактических данных, а не пример разобранного документа.
  "formatVersion": "1.0", // Версия этого JSON-контракта, а не версия DSL. Версия намеренно сохранена без изменения.

  "document": {
    // Сведения об исходном документе. Неизвестные сведения представлены null, а не выдуманными значениями.
    "dslVersion": "<string|null>", // Прочитанное значение версии DSL. Сейчас поддерживается "1.2". Неподдерживаемая версия сохраняется без подмены и сопровождается диагностикой; отсутствие версии — null.
    "fileName": "<string|null>", // Имя входного DSL-файла с расширением; null, если имя неизвестно. Это не имя выходного JSON/JSONC-файла.
    "filePath": "<string|null>", // Абсолютный путь входного файла; null для источника без известного файлового пути. Если путь известен, fileName совпадает с его последним компонентом.
    "encoding": "<string|null>", // Для успешно принятого байтового входа — "UTF-8". null означает, что кодировку установить нельзя. Другие кодировки этим профилем не поддерживаются.
    "hasBom": false, // boolean|null: true — точные исходные байты начинаются с UTF-8 BOM; false — BOM отсутствует; null — байтовый вход невозможно прочитать или проверить.
    "lineCount": 0, // integer|null: число физических строк. 0 означает пустой файл; null — полное число неизвестно. При полном чтении равно длине lines, а номера строк образуют последовательность 1..lineCount.
    "byteLength": 0, // integer >= 0|null: размер полного исходника в байтах, включая BOM и переводы строк; null, если полный размер неизвестен.
    "sha256": "<string|null>", // SHA-256 точных исходных байтов: 64 шестнадцатеричных символа нижнего регистра; null, если полный источник недоступен.

    "metadata": {
      // Однозначно извлечённые метаданные. Все исходные объявления независимо от результата извлечения остаются в lines.
      // Если одиночное значение отсутствует или не может быть однозначно установлено, соответствующее поле равно null.
      "documentId": "<string|null>", // Значение @document-id с сохранённым исходным регистром.
      "title": "<string|null>", // Свободный текст единственного заголовка #; null, если такого заголовка нет или значение неоднозначно.
      "subtitle": "<string|null>", // Свободный текст необязательного заголовка ##; null, если его нет или значение неоднозначно.
      "section": "<string|null>", // Значение @section: свободное имя, не закрытое перечисление. Исходный регистр сохраняется.
      "order": "<string|null>", // Исходная допустимая запись положительного целого из @order. Хранится строкой без преобразования в JSON number, чтобы не терять точность и ведущие нули.
      "resourceDirs": [] // string[]|null: значения @resource-dir в порядке объявлений; [] — объявлений нет; null — извлечение метаданных недоступно. Наличие каталогов не проверяется.
    },

    "hasErrors": false // boolean: true тогда и только тогда, когда diagnostics содержит хотя бы одну запись severity="error". Warning и recommendation сами по себе не устанавливают этот признак.
  },

  "processing": [
    // Плоская история фактически начатых запусков инструментов в порядке начала обработки.
    // Положение записи в массиве является нормативным порядком; startedAt носит информационный характер.
    {
      "id": "<processing-id>", // Непустая строка, уникальная в пределах processing. Все diagnostics[].source ссылаются на эти идентификаторы.
      "tool": "<string>", // Стабильное машинное имя инструмента, например "dsl-parser" или "dsl-validator". Это открытый словарь.
      "version": "<string|null>", // Версия инструмента в его собственном формате; null, если инструмент её не сообщает.
      "startedAt": "<date-time|null>", // Начало обработки в RFC 3339 с часовым поясом, например "2026-09-16T14:25:30.123+03:00"; null, если время неизвестно.
      "durationMs": 0 // integer >= 0|null: продолжительность в миллисекундах; 0 допустим для операции короче 1 мс; null, если длительность неизвестна или запуск не завершился штатно.
    }
  ], // [] означает, что сведения о запусках отсутствуют. Повторный запуск инструмента создаёт новую запись с новым id.

  "lines": [
    // Плоский массив всех физических строк в исходном порядке. При полном чтении lines[i].line == i + 1.
    // Пустой файл представлен lineCount=0 и lines=[]. Фиктивная строка 0 не создаётся.
    {
      "line": 1, // integer >= 1: уникальный номер физической строки.

      "type": "<line-type>",
      // Закрытое перечисление line-type:
      // "tag"         — однострочное объявление DSL-тега, включая task/step/variant/endtask и технические теги;
      // "heading"     — строка #, ## или ###; nestingLevel всегда 0, синтаксический уровень хранится в heading-level;
      // "content"     — строка содержимого; принадлежность определяется через parentLine;
      // "block-start" — объявление с открывающей фигурной скобкой; имя тега, параметры и обязательная скобка выделяются отдельными elements;
      // "block-end"   — отдельная закрывающая }; parentLine указывает на соответствующую строку block-start;
      // "separator"   — отдельная строка --- в допускающем её контейнере; экранированная последовательность не является separator;
      // "blank"       — строка, пустая после удаления крайних U+0020 и TAB и игнорируемая DSL;
      // "invalid"     — строка, которую невозможно классифицировать как допустимую конструкцию.
      // Ошибка параметра уже распознанного тега не меняет type на invalid: сохраняются tag/block-start и успешно выделенные элементы.
      // Пустая строка предзаполненного multifill имеет type="content" и content.value="", а не type="blank".

      "nestingLevel": 0, // integer >= 0: логическая глубина вложенности, не количество символов #. При parentLine=null равно 0; иначе равно nestingLevel родителя + 1. Каждый heading имеет 0.
      "parentLine": null, // integer >= 1|null: номер существующей предшествующей родительской строки. Всегда меньше line. У heading — null. У block-end — строка соответствующего block-start.

      "raw": "<string>", // Точная исходная строка без BOM и EOL. Все начальные/конечные U+0020, TAB и другие символы сохраняются; экранирование не снимается.
      "eol": "<line-ending>", // Закрытое перечисление: "\n" | "\r\n" | "". "" разрешено только у последней строки при EOF без перевода строки. Одиночный CR не является допустимым EOL.

      "hasErrors": false, // boolean: true тогда и только тогда, когда severity="error" имеет основную location, начинающуюся на этой строке, либо на такую диагностику ссылается хотя бы один element.errorIds. Ошибки дочерних строк не наследуются.

      "elements": [
        // Плоский массив элементов этой строки, отсортированный по start, затем по end.
        // Диапазоны разных элементов не пересекаются. Элементы не обязаны покрывать пробелы и весь line.raw.
        // Необязательный отсутствующий элемент не создаётся. Для отсутствующего обязательного значения разрешён пустой элемент в позиции вставки.
        {
          "type": "<element-type>",
          // Закрытое перечисление element-type:
          // "tag" | "heading-level" | "title" | "content" | "identifier" | "name" | "version" | "number" |
          // "media-type" | "source" | "resource-path" | "placeholder" | "unparsed" | "block-open" | "block-close".

          "raw": "<string>", // Точный фрагмент line.raw по кодовым точкам от start включительно до end исключительно. При start=end всегда "".
          "value": "<string|null>", // Семантическое значение элемента. Точный смысл и допустимость null определяются словарём типов элементов ниже.
          "start": 1, // integer >= 1: начальная колонка в line.raw; счёт с 1 по Unicode-кодовым точкам, не по байтам и не по UTF-16 units.
          "end": 1, // integer >= start: исключающая конечная колонка. Максимум — число кодовых точек в line.raw + 1. start=end обозначает позицию отсутствующего обязательного значения.

          "errorIds": [
            "<diagnostic-id>"
          ] // string[] без повторов: ссылки на существующие diagnostics[].id со scope="element". Порядок совпадает с порядком соответствующих записей в diagnostics. Для корректного элемента — [].
        }
      ]
      // Инвариант элемента: raw равен фрагменту line.raw по заданному диапазону кодовых точек.
      // Ошибки scope="line", "block" и "document" не требуют создания искусственного элемента и не включаются в errorIds.
    }
  ],

  "diagnostics": [
    // Единый накопительный массив диагностик всех запусков инструментов.
    // Нормативный порядок: порядок source в processing, затем начальная строка, начальная колонка и порядок обнаружения.
    {
      "id": "<diagnostic-id>", // Непустая строка, уникальная в пределах diagnostics. Идентификатор стабилен только внутри этого результата.
      "source": "<processing-id>", // id существующей записи processing: конкретного запуска инструмента, создавшего диагностику.
      "code": "<diagnostic-code>", // Устойчивый машинный код из реестра инструмента source. Это открытый словарь; message не используется вместо code.
      "severity": "<diagnostic-severity>", // Закрытое перечисление: "error" | "warning" | "recommendation". fatal=true допустимо только при severity="error".
      "message": "<string>", // Человекочитаемое описание конкретной проблемы. Свободная строка; не является стабильным машинным идентификатором.
      "scope": "<diagnostic-scope>", // Закрытое перечисление: "element" | "line" | "block" | "document".
      "fatal": false, // boolean: true означает, что создавший диагностику запуск инструмента не мог штатно продолжить обработку; false — остальные результаты могли быть сохранены.

      "location": {
        // Основной непрерывный диапазон исходника. null означает отсутствие привязки к исходной позиции, например при нечитаемом входе.
        // Для scope="element" location обязательна и должна совпадать с диапазоном хотя бы одного элемента, содержащего id этой диагностики в errorIds.
        // Для scope="line" диапазон находится в одной строке. Для scope="block" разрешён многострочный диапазон.
        "start": {
          "line": 1, // integer >= 1: начальная физическая строка.
          "column": 1 // integer >= 1: начальная колонка в кодовых точках.
        },
        "end": {
          "line": 1, // integer >= start.line: конечная физическая строка.
          "column": 1 // integer >= 1: исключающая конечная колонка в end.line. Если строки совпадают, column >= start.column.
        }
      },

      "relatedLocations": [
        {
          // Дополнительное место, связанное с диагностикой: например, первое из двух объявлений ID или парная граница блока.
          "start": {
            "line": 1,
            "column": 1
          },
          "end": {
            "line": 1,
            "column": 1
          }
        }
      ] // [] при отсутствии дополнительных мест. Диапазоны не дублируют основную location и не повторяются.
    }
  ]
  // diagnostics=[] означает отсутствие диагностик.
  // Каждая ссылка должна быть целостной: diagnostics.source существует в processing.id; element.errorIds — в diagnostics.id; parentLine — в lines.line.
  // Для scope="element" обязательна хотя бы одна обратная ссылка из element.errorIds; для остальных scope такая ссылка не создаётся.
  // Последующий инструмент добавляет собственные processing и diagnostics, но не изменяет строки, элементы и диагностики предыдущих инструментов.
}

// СЛОВАРЬ ЗНАЧЕНИЙ И ПРАВИЛ ЭЛЕМЕНТОВ
//
// tag
//   value содержит одно из 34 канонических имён без @:
//   dsl-version | document-id | section | order | resource-dir | header | task | endtask | step | speaking |
//   newpage | editor | media | example | wordlist | table | script | text | key | instr | note | alt | hint |
//   fragment | include | answer | question | multifill | choice | multichoice | matching | ordering | variants | variant.
//   raw сохраняет исходное написание с @ и исходный регистр. Неизвестный тег представлен element.type="unparsed",
//   value=null и ссылкой на диагностику; соседние корректные элементы сохраняются.
//
// heading-level
//   value: "1" | "2" | "3"; raw: "#" | "##" | "###" соответственно.
//   Это синтаксический уровень заголовка, а не lines[].nestingLevel.
//
// title
//   value — свободный текст названия heading, header/step или поддерживающего TITLE блочного тега.
//   Закрытого перечисления значений нет.
//
// content
//   value — всё выделенное текстовое содержимое либо инструкция после обработки синтаксически значимого экранирования DSL.
//   Для содержимого тегов text/table это целая строка без разбора HTML, ячеек и внутренних разделителей.
//   Такая строка имеет line.type="content"; отдельных типов строк text/table нет.
//
// identifier
//   value — ID из document-id/task/fragment/include с сохранённым исходным регистром.
//   Регистронезависимое сравнение не изменяет value.
//
// name
//   value — свободное имя section/variant; это не ID и не перечисление фиксированных слов.
//
// version
//   value — прочитанная строка версии. Сейчас поддерживается "1.2".
//   Неподдерживаемое значение сохраняется и не подменяется на "1.2"; диагностика указывается через errorIds.
//
// number
//   value — исходная числовая запись order строкой, включая допустимые ведущие нули.
//   Значение не преобразуется в JSON number.
//
// media-type
//   value: "audio" | "video" | "image". Для недопустимого значения raw сохраняется, value=null,
//   а errorIds содержит ссылку на диагностику.
//
// source
//   value — путь media без ограничивающих кавычек либо номер media строкой с ведущими нулями.
//   Кавычки сохраняются только в raw: "12" задаёт путь, 12 без кавычек — номер.
//
// resource-path
//   value — один путь из resource-dir; каждая запись списка создаёт отдельный элемент.
//   Запятая внутри кавычек является частью пути; обратная косая черта буквальна. Ограничивающие кавычки остаются в raw, но не входят в value.
//
// placeholder
//   raw — вся запись _____ или _____{ANSWER}.
//   value — выделенный ANSWER либо null исключительно для корректного placeholder без ответа.
//   Отсутствие ответа не является ошибкой и даёт errorIds=[]. Синтаксически испорченный placeholder представлен как unparsed,
//   поэтому null у placeholder нельзя спутать с невозможностью разбора.
//
// unparsed
//   raw — ошибочный фрагмент либо вся invalid-строка; value=null; errorIds содержит хотя бы одну диагностику scope="element".
//   Успешно выделенные соседние элементы сохраняются. Для line.type="invalid" elements содержит как минимум один unparsed.
//   Строковая, блочная или документная диагностика сама по себе не требует искусственного unparsed.
//
// block-open
//   raw="{"; value="{". Обязательный отдельный элемент строки block-start.
//
// block-close
//   raw="}"; value="}". Обязательный отдельный элемент строки block-end.

// ОБЩИЕ ИНВАРИАНТЫ
// 1. Идентификаторы processing.id и diagnostics.id уникальны внутри своих массивов и не являются стабильными между повторными запусками.
// 2. parentLine < line; цепочка parentLine конечна; nestingLevel родителя и потомка согласован.
// 3. При полном чтении lines[i].line=i+1 и document.lineCount=lines.length.
// 4. Файл, заканчивающийся EOL, не создаёт дополнительную фиктивную пустую строку: EOL хранится у последней реальной строки.
// 5. Для пустого файла lineCount=0 и lines=[].
// 6. element.raw проверяется по диапазону Unicode-кодовых точек, а не срезом байтов Go-строки.
// 7. В массивах ссылок, элементов и связанных мест дубликаты запрещены.
// 8. Неизвестные поля объектов должны игнорироваться потребителем при совпадающей поддерживаемой версии formatVersion.
